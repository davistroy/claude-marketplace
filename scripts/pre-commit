#!/bin/bash
#
# Pre-commit hook for claude-marketplace
# Validates staged markdown files in the plugins directory
# and checks Python files with ruff
#
# Checks performed:
#   1. Frontmatter validation:
#      - description: REQUIRED for all commands and skills
#      - name: FORBIDDEN for commands, REQUIRED for skills (and must match dir name)
#   2. Code block closure validation
#   3. Timestamp format validation (YYYYMMDD-HHMMSS)
#   4. Injection linter (ADR-0011) -- replays the harness pre-pass to find
#      unguarded or ungranted live dynamic injections in staged skill/command
#      bodies (scripts/check_injections.py)
#   5. Agent model-alias enforcement (ADR-0005, scripts/check_agent_models.py)
#   6. Python lint/format check with ruff
#   7. Release integrity -- a bump-worthy change under plugins/<name>/ requires
#      a version bump, and a version bump requires a CHANGELOG.md entry
#      (scripts/check_version_bump.py, #226/#210)
#   8. SKILL.md body budget -- a skill body (post-frontmatter) must stay under
#      500 lines (scripts/check_skill_budget.py, #238)
#
# Target: < 5 seconds execution time
#
# Installation:
#   bash scripts/install-hooks.sh
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running plugin validation pre-commit hook..."
echo ""

# Get list of staged .md files in plugins/ commands and skills only (excluding CHANGELOG, README, references)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^plugins/[^/]+/(commands/.*\.md|skills/[^/]+/SKILL\.md)$' || true)

# Track errors
ERRORS=0
WARNINGS=0

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No plugin markdown files staged. Skipping markdown validation.${NC}"
    echo ""
else

echo "Validating staged plugin files:"
echo "$STAGED_FILES" | while read -r file; do
    echo "  - $file"
done
echo ""

# Validate each staged file
for FILE in $STAGED_FILES; do
    if [ ! -f "$FILE" ]; then
        continue
    fi

    echo "Checking: $FILE"

    # Check for frontmatter delimiters
    FIRST_LINE=$(head -n 1 "$FILE")
    if [ "$FIRST_LINE" != "---" ]; then
        echo -e "  ${RED}[FAIL]${NC} Missing frontmatter (must start with ---)"
        ERRORS=$((ERRORS + 1))
        continue
    fi

    # Extract frontmatter (between first two ---)
    FRONTMATTER=$(sed -n '2,/^---$/p' "$FILE" | head -n -1)

    if [ -z "$FRONTMATTER" ]; then
        echo -e "  ${RED}[FAIL]${NC} Empty or malformed frontmatter"
        ERRORS=$((ERRORS + 1))
        continue
    fi

    # Check for required 'description' field
    if ! echo "$FRONTMATTER" | grep -q "^description:"; then
        echo -e "  ${RED}[FAIL]${NC} Missing required 'description' field in frontmatter"
        ERRORS=$((ERRORS + 1))
    else
        echo -e "  ${GREEN}[PASS]${NC} description field present"
    fi

    # Determine if this is a command or skill based on path
    IS_SKILL=false
    if echo "$FILE" | grep -q "/skills/"; then
        IS_SKILL=true
    fi

    # Check name field: FORBIDDEN for commands, REQUIRED for skills (and must match dir name)
    if [ "$IS_SKILL" = true ]; then
        # Skills REQUIRE name field (needed for skill registration), and it MUST
        # equal the skill's parent directory name (house convention, ADR-0006;
        # matches the skills/*/SKILL.md rule enforced in .github/workflows/validate.yml)
        if echo "$FRONTMATTER" | grep -q "^name:"; then
            SKILL_DIR_NAME=$(basename "$(dirname "$FILE")")
            NAME_VALUE=$(echo "$FRONTMATTER" | grep "^name:" | head -n 1 | sed -E "s/^name:[[:space:]]*//; s/[\"']//g" | xargs)
            if [ "$NAME_VALUE" = "$SKILL_DIR_NAME" ]; then
                echo -e "  ${GREEN}[PASS]${NC} Required 'name' field present and matches directory name (skill)"
            else
                echo -e "  ${RED}[FAIL]${NC} 'name' field ('$NAME_VALUE') does not match directory name ('$SKILL_DIR_NAME')"
                echo -e "         Skills must have: name: $SKILL_DIR_NAME (matching directory name)"
                ERRORS=$((ERRORS + 1))
            fi
        else
            echo -e "  ${RED}[FAIL]${NC} Missing required 'name' field in skill frontmatter"
            echo -e "         Skills must have: name: skill-name (matching directory name)"
            ERRORS=$((ERRORS + 1))
        fi
    else
        # Commands should NOT have name field (filename determines command name)
        if echo "$FRONTMATTER" | grep -q "^name:"; then
            echo -e "  ${RED}[FAIL]${NC} Forbidden 'name' field found (filename determines command name)"
            ERRORS=$((ERRORS + 1))
        else
            echo -e "  ${GREEN}[PASS]${NC} No forbidden 'name' field (command)"
        fi
    fi

    # Check for basic YAML syntax (colon after field name)
    if echo "$FRONTMATTER" | grep -E "^[a-z]+" | grep -v ":"; then
        echo -e "  ${YELLOW}[WARN]${NC} Possible YAML syntax issue (missing colon?)"
        WARNINGS=$((WARNINGS + 1))
    fi

    # Check for unclosed code blocks
    BACKTICK_COUNT=$(grep -c '```' "$FILE" || true)
    if [ $((BACKTICK_COUNT % 2)) -ne 0 ]; then
        echo -e "  ${RED}[FAIL]${NC} Unclosed code block (odd number of \`\`\`)"
        ERRORS=$((ERRORS + 1))
    fi

    echo ""
done

# ============================================
# Check 3: Timestamp Format Validation
# ============================================
echo "Checking timestamp format in staged files..."

TIMESTAMP_PATTERN='[0-9]{8}-[0-9]{6}'
VALID_TIMESTAMP_REGEX='^[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])-([01][0-9]|2[0-3])([0-5][0-9])([0-5][0-9])$'

for FILE in $STAGED_FILES; do
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # Look for timestamp-like patterns in the file
    TIMESTAMPS=$(grep -oE "$TIMESTAMP_PATTERN" "$FILE" 2>/dev/null || true)

    for ts in $TIMESTAMPS; do
        # Validate the timestamp format (basic check for valid date/time ranges)
        YEAR=$(echo "$ts" | cut -c1-4)
        MONTH=$(echo "$ts" | cut -c5-6)
        DAY=$(echo "$ts" | cut -c7-8)
        HOUR=$(echo "$ts" | cut -c10-11)
        MIN=$(echo "$ts" | cut -c12-13)
        SEC=$(echo "$ts" | cut -c14-15)

        # Check ranges
        if [ "$MONTH" -lt 1 ] || [ "$MONTH" -gt 12 ] 2>/dev/null; then
            echo -e "  ${YELLOW}[WARN]${NC} $FILE: Invalid month in timestamp '$ts'"
            echo -e "         Expected: YYYYMMDD-HHMMSS (month 01-12)"
            WARNINGS=$((WARNINGS + 1))
        elif [ "$DAY" -lt 1 ] || [ "$DAY" -gt 31 ] 2>/dev/null; then
            echo -e "  ${YELLOW}[WARN]${NC} $FILE: Invalid day in timestamp '$ts'"
            echo -e "         Expected: YYYYMMDD-HHMMSS (day 01-31)"
            WARNINGS=$((WARNINGS + 1))
        elif [ "$HOUR" -gt 23 ] 2>/dev/null; then
            echo -e "  ${YELLOW}[WARN]${NC} $FILE: Invalid hour in timestamp '$ts'"
            echo -e "         Expected: YYYYMMDD-HHMMSS (hour 00-23)"
            WARNINGS=$((WARNINGS + 1))
        elif [ "$MIN" -gt 59 ] || [ "$SEC" -gt 59 ] 2>/dev/null; then
            echo -e "  ${YELLOW}[WARN]${NC} $FILE: Invalid minute/second in timestamp '$ts'"
            echo -e "         Expected: YYYYMMDD-HHMMSS (min/sec 00-59)"
            WARNINGS=$((WARNINGS + 1))
        fi
    done
done

echo -e "  ${GREEN}[PASS]${NC} Timestamp format check complete"
echo ""

# ============================================
# Check 4: Injection Linter (ADR-0011 replay)
# ============================================
echo "Checking dynamic injections replay-clean (ADR-0011)..."
if python3 scripts/check_injections.py; then
    echo -e "  ${GREEN}[PASS]${NC} No unguarded/ungranted live injections"
else
    echo -e "  ${RED}[FAIL]${NC} Injection linter found issues (see above)"
    ERRORS=$((ERRORS + 1))
fi
echo ""

fi  # End of markdown file checks (STAGED_FILES non-empty)

# ============================================
# Check 5: Agent Model-Alias Enforcement (ADR-0005)
# ============================================
echo "Checking agent model aliases (ADR-0005)..."
AGENT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.claude/agents/.*\.md$|^plugins/[^/]+/agents/.*\.md$' || true)

if [ -n "$AGENT_FILES" ]; then
    echo "Staged agent file(s):"
    echo "$AGENT_FILES" | while read -r file; do
        echo "  - $file"
    done
    echo ""
    if python3 scripts/check_agent_models.py; then
        echo -e "  ${GREEN}[PASS]${NC} Agent model aliases compliant (ADR-0005)"
    else
        echo -e "  ${RED}[FAIL]${NC} Agent model-alias check found issues (see above)"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "  ${GREEN}[SKIP]${NC} No agent files staged"
fi
echo ""

# ============================================
# Check 6: Python File Lint/Format with ruff
# ============================================
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$PYTHON_FILES" ]; then
    echo "Checking Python files with ruff..."
    if command -v ruff &> /dev/null; then
        RUFF_ERRORS=0
        ruff check $PYTHON_FILES || { echo -e "  ${RED}[FAIL]${NC} Ruff lint check failed"; RUFF_ERRORS=$((RUFF_ERRORS + 1)); }
        ruff format --check $PYTHON_FILES || { echo -e "  ${RED}[FAIL]${NC} Ruff format check failed"; RUFF_ERRORS=$((RUFF_ERRORS + 1)); }
        if [ $RUFF_ERRORS -eq 0 ]; then
            echo -e "  ${GREEN}[PASS]${NC} ruff lint check passed"
            echo -e "  ${GREEN}[PASS]${NC} ruff format check passed"
        fi
        ERRORS=$((ERRORS + RUFF_ERRORS))
    else
        echo -e "  ${YELLOW}[WARN]${NC} ruff not installed — skipping Python checks"
        echo -e "         Install with: pip install ruff"
        WARNINGS=$((WARNINGS + 1))
    fi
    echo ""
fi

# ============================================
# Check 7: Release Integrity -- version bump + CHANGELOG (#226 / #210)
# ============================================
echo "Checking release integrity (version bump + CHANGELOG)..."

# NOTE: this deliberately does NOT reuse $STAGED_FILES. That filter (line ~36)
# matches only `commands/*.md` and `skills/*/SKILL.md`, so it is blind to
# tools/, references/, agents/, and hooks/ -- all of which are bump-worthy.
# This filter is the whole `plugins/<name>/` subtree and applies NO exemption
# logic of its own: deciding whether a path is bump-worthy or exempt belongs to
# check_version_bump.py's EXEMPT_EXACT / EXEMPT_GLOBS, its single source of
# truth. Restating that set here would let the copy drift into agreeing with a
# bug (CLAUDE.md: "derive it, don't copy it"). A CHANGELOG-only stage therefore
# still runs the script -- and the script correctly exits 0.
PLUGIN_STAGED=$(git diff --cached --name-only | grep -E '^plugins/[^/]+/' || true)

if [ -z "$PLUGIN_STAGED" ]; then
    echo -e "  ${GREEN}[SKIP]${NC} No files staged under plugins/"
else
    # The pre-commit leg has no PR base ref, so resolve one the way CI would:
    # origin/main first (CLAUDE.md -- the local branch can silently lag origin),
    # then a local main. The script diffs merge-base(base, head)...head, so this
    # sees exactly what the PR gate will see, plus the staged changes.
    BUMP_BASE=""
    for CAND in origin/main main; do
        if git rev-parse --verify --quiet "${CAND}^{commit}" >/dev/null 2>&1; then
            BUMP_BASE="$CAND"
            break
        fi
    done

    # The staged content is not yet any commit, so materialize it as a dangling
    # commit object: `write-tree` snapshots the index, `commit-tree` parents it
    # on HEAD. Nothing is committed and no ref moves -- the object is unreachable
    # and gets garbage-collected. This is what lets the check see the change
    # about to be committed rather than the last one that already was.
    PENDING=""
    HEAD_SHA=$(git rev-parse --verify --quiet HEAD 2>/dev/null || true)
    if [ -n "$HEAD_SHA" ]; then
        STAGED_TREE=$(git write-tree 2>/dev/null || true)
        if [ -n "$STAGED_TREE" ]; then
            PENDING=$(git commit-tree "$STAGED_TREE" -p "$HEAD_SHA" \
                          -m "pre-commit: staged tree (not a real commit)" 2>/dev/null || true)
        fi
    fi

    # Every skip below is announced with its reason. This check must never block
    # a commit just because a base could not be determined -- an unresolvable
    # base is a local-environment fact, not a release-integrity violation, and
    # the PR leg in CI gates the same content authoritatively.
    if [ -z "$BUMP_BASE" ]; then
        echo -e "  ${YELLOW}[SKIP]${NC} No origin/main or main to diff against -- cannot"
        echo -e "         determine a base locally. CI's pull_request leg still enforces this."
    elif [ -z "$HEAD_SHA" ]; then
        echo -e "  ${YELLOW}[SKIP]${NC} No HEAD commit yet (initial commit) -- no base to diff."
    elif [ -z "$PENDING" ]; then
        echo -e "  ${YELLOW}[SKIP]${NC} Could not snapshot the staged tree (git write-tree /"
        echo -e "         commit-tree failed -- committer identity unset?). Not blocking."
    elif ! git merge-base "$BUMP_BASE" "$PENDING" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}[SKIP]${NC} No merge-base between $BUMP_BASE and the staged tree"
        echo -e "         (unrelated histories or a shallow clone). Not blocking."
    elif python3 scripts/check_version_bump.py --base "$BUMP_BASE" --head "$PENDING"; then
        echo -e "  ${GREEN}[PASS]${NC} Release integrity OK (bump-required + changelog-required)"
    else
        echo -e "  ${RED}[FAIL]${NC} Release-integrity check failed (see above)"
        ERRORS=$((ERRORS + 1))
    fi
fi
echo ""

# ============================================
# Check 8: SKILL.md Body Budget (#238)
# ============================================
echo "Checking SKILL.md body budget (under 500 lines)..."

# File selection is DELEGATED to the script's `--filter` mode, which pipes the
# staged path list through the same `in_scope()` predicate the full scan uses.
# Restating `plugins/*/skills/*/SKILL.md` in shell here is precisely how the two
# copies drift apart (CLAUDE.md: "derive it, don't copy it") -- and $STAGED_FILES
# above cannot be reused either: its regex also matches commands/*.md, which this
# gate deliberately does NOT cover (frozen legacy, ADR-0006).
SKILL_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
                   | python3 scripts/check_skill_budget.py --filter || true)

if [ -z "$SKILL_STAGED" ]; then
    echo -e "  ${GREEN}[SKIP]${NC} No skill bodies staged"
else
    echo "Staged skill body/bodies:"
    echo "$SKILL_STAGED" | while read -r file; do
        echo "  - $file"
    done
    # Only the staged bodies are measured, not the whole tree: a pre-existing
    # over-budget file elsewhere is not this commit's problem, and CI's full scan
    # gates that authoritatively.
    if python3 scripts/check_skill_budget.py $SKILL_STAGED; then
        echo -e "  ${GREEN}[PASS]${NC} Every staged skill body is under 500 lines"
    else
        echo -e "  ${RED}[FAIL]${NC} Skill body budget exceeded (see above)"
        ERRORS=$((ERRORS + 1))
    fi
fi
echo ""

# ============================================
# Summary
# ============================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Validation Summary"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}Errors: $ERRORS${NC}"
    echo -e "${YELLOW}Warnings: $WARNINGS${NC}"
    echo ""
    echo -e "${RED}Commit blocked. Please fix the errors above.${NC}"
    echo ""
    echo "Tips:"
    echo "  - Every command/skill needs frontmatter with 'description'"
    echo "  - Commands: Do NOT include 'name' field (filename determines command name)"
    echo "  - Skills: MUST include 'name' field matching the directory name (required for skill registration)"
    echo "  - Ensure all code blocks are closed with \`\`\`"
    echo "  - Use YYYYMMDD-HHMMSS format for timestamps (e.g., 20260114-143052)"
    echo "  - Live dynamic injections (!\`cmd\`) must be exit-0-guarded and every"
    echo "    binary they call must be in allowed-tools (ADR-0011) -- see"
    echo "    python3 scripts/check_injections.py for details on a failure"
    echo "  - Agent model: must use tier aliases (haiku|sonnet|opus|fable|inherit), never"
    echo "    pinned model IDs (ADR-0005) -- see docs/adr/0005-model-aliases-in-agent-definitions.md"
    echo "  - Python files must pass ruff check and ruff format"
    echo "    Fix with: ruff check --fix . && ruff format ."
    echo "  - A SKILL.md body (everything after the closing frontmatter ---) must stay"
    echo "    under 500 lines (#238) -- move long samples/tables into the skill's"
    echo "    references/ directory and leave a one-line pointer in the body"
    echo "  - A bump-worthy change under plugins/<name>/ requires a version bump in that"
    echo "    plugin's plugin.json, and a bump requires a CHANGELOG.md entry for the new"
    echo "    version (#226/#210) -- fix with: /bump-version <plugin> <major|minor|patch>"
    echo ""
    echo "To bypass this check (not recommended):"
    echo "  git commit --no-verify"
    exit 1
else
    if [ $WARNINGS -gt 0 ]; then
        echo -e "${GREEN}Errors: 0${NC}"
        echo -e "${YELLOW}Warnings: $WARNINGS${NC}"
        echo ""
        echo -e "${GREEN}Validation passed with warnings.${NC}"
    else
        echo -e "${GREEN}All checks passed!${NC}"
    fi
    exit 0
fi
